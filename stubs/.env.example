#
# CorePanel - environment template
# Copy this file to .env as a neutral starting point. Adjust values for your
# local machine, Docker setup or deployment environment.
#

### Application ###############################################################
# APP_KEY is required for encryption, sessions and signed URLs. Generate it with:
# php artisan key:generate
# APP_URL is the canonical app URL used for links in mails, queues and Artisan.
# ASSET_URL controls where compiled frontend assets are loaded from.
APP_NAME="CorePanel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
ASSET_URL=
APP_VERSION=1.3.1
APP_TIMEZONE=Europe/Berlin

### Localization #############################################################
# APP_LOCALE is the default UI language. APP_FALLBACK_LOCALE is used for
# missing translations. APP_FAKER_LOCALE controls generated test/demo data.
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

### Logging ##################################################################
# LOG_CHANNEL selects the default Laravel logger. LOG_LEVEL controls verbosity.
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_LEVEL=debug

### Database #################################################################
# Main PostgreSQL connection. DB_DATABASE_TEST is used by the test bootstrap.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=core_panel
DB_USERNAME=core_panel
DB_PASSWORD=CHANGEME
DB_DATABASE_TEST=core_panel_test

### Database Backups #########################################################
# Controls backup creation, retention and restore timeouts for the
# administration area.
DATABASE_BACKUPS_AUTOMATIC_ENABLED=false
DATABASE_BACKUPS_ENABLED=true
DATABASE_BACKUPS_ENCRYPTION_ENABLED=false
DATABASE_BACKUPS_IMPORT_MAX_SIZE_KB=1048576
DATABASE_BACKUPS_PATH=
DATABASE_BACKUPS_RESTORE_STATUS_STORE=file
DATABASE_BACKUPS_RESTORE_TIMEOUT=900
DATABASE_BACKUPS_RETENTION_COUNT=30
DATABASE_BACKUPS_RETENTION_DAYS=30
DATABASE_BACKUPS_RETENTION_MODE=count
DATABASE_BACKUPS_SCHEDULE_MODE=daily
DATABASE_BACKUPS_SYSTEM_TIME=02:00
DATABASE_BACKUPS_TIMEOUT=900
DATABASE_BACKUPS_TIME=02:00
DATABASE_BACKUPS_TIMEZONE=Europe/Berlin
DATABASE_BACKUPS_TIME_MODE=system

### Sessions and Proxies #####################################################
# SESSION_DRIVER=database stores sessions in PostgreSQL. Set TRUSTED_PROXIES
# when running behind a reverse proxy that terminates HTTPS.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
TRUSTED_PROXIES=*

### Cache, Queue, Files and Broadcast ########################################
# Redis is used for cache and queues. FILESYSTEM_DISK=public keeps uploaded
# files under public storage by default.
BROADCAST_CONNECTION=log
CACHE_STORE=redis
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

### Redis ####################################################################
# Redis connection used by cache, queues and Horizon.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

### Mail #####################################################################
# Configure SMTP for the target environment.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="CorePanel"

### Core Panel ###############################################################
# Controls the admin route prefix, auth features, API token lifetimes and
# enabled social login providers.
ROUTE_PREFIX=admin
API_VERSION=v1
EMAIL_VERIFICATION_ENABLED=true
PASSWORD_RESET_ENABLED=true
REGISTRATION_ENABLED=true
TWO_FACTOR_ENABLED=true
PASSPORT_PERSONAL_ACCESS_CLIENTS_ENABLED=false
PASSPORT_PERSONAL_ACCESS_TOKEN_TTL_DAYS=180
PASSPORT_REFRESH_TOKEN_TTL_DAYS=30
PASSPORT_TOKEN_TTL_MINUTES=15
SOCIAL_GITHUB_ENABLED=false
SOCIAL_GOOGLE_ENABLED=false
SOCIAL_MASTER_PROVIDER=
SOCIAL_MICROSOFT_ENABLED=false

### Security #################################################################
# Toggle CorePanel's default response security headers if needed.
SECURITY_CSP_REPORT_ONLY=false
SECURITY_HEADERS_ENABLED=true

### Horizon ##################################################################
# Optional Slack notification target for Horizon queue alerts.
HORIZON_ENABLED=true
HORIZON_SLACK_CHANNEL=
HORIZON_SLACK_WEBHOOK_URL=

### Social Login #############################################################
# Fill only the providers enabled above. Redirect URIs must match the provider
# app settings.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

### Docker Ports #############################################################
# Host ports exposed by docker-compose.yml and docker-compose.dev.yml.
APP_PORT=8000
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_SMTP_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
SYSTEM_UPDATER_PORT=8080

### Docker Development Overrides #############################################
# DEV_* values override app URL/debug settings for docker-compose.dev.yml.
DEV_APP_URL=http://localhost:8000
DEV_ASSET_URL=http://localhost:8000
DEV_APP_DEBUG=true

### Docker Production Paths ##################################################
# Used by docker-compose.prod.yml for persistent storage and updater access.
STORAGE_ROOT_PATH=/srv/docker/core-panel/storage
POSTGRES_DATA_PATH=/srv/docker/core-panel/postgres
REDIS_DATA_PATH=/srv/docker/core-panel/redis/data
SYSTEM_UPDATER_PROJECT_PATH=/srv/docker/core-panel
SYSTEM_UPDATER_DOCKER_CONFIG_PATH=/srv/docker/core-panel/docker-config
UPDATER_DATA_PATH=/srv/docker/core-panel/updater/data
PORTAINER_DATA_PATH=/srv/docker/portainer/data

### Octane ###################################################################
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false
OCTANE_HOST=0.0.0.0
OCTANE_PORT=8000

### System Updates ###########################################################
# Enables the administration update UI and optional automatic update window.
SYSTEM_UPDATES_ENABLED=true
SYSTEM_UPDATES_DOCKER_ONLY=true
SYSTEM_UPDATES_FORCE_UPDATE_ENABLED=false
SYSTEM_UPDATES_AUTOMATIC_ENABLED=false
SYSTEM_UPDATES_AUTOMATIC_INACTIVE_MINUTES=15
SYSTEM_UPDATES_AUTOMATIC_TIMEZONE=Europe/Berlin
SYSTEM_UPDATES_AUTOMATIC_WINDOW_START=02:00
SYSTEM_UPDATES_AUTOMATIC_WINDOW_END=04:00

### System Updater ###########################################################
# Protect updater API requests with a dedicated token when using the Docker
# system update flow.
SYSTEM_UPDATES_UPDATER_URL=http://system-updater:8080
SYSTEM_UPDATES_TOKEN=CHANGE_ME
SYSTEM_UPDATES_TIMEOUT=10
SYSTEM_UPDATES_CONNECT_TIMEOUT=3
SYSTEM_UPDATES_CHECK_TIMEOUT=120
SYSTEM_UPDATES_UPDATE_TIMEOUT=600

### Docker System Updater ####################################################
# Advanced docker-compose settings for the standalone updater service.
# Add docker-compose.registry.yml explicitly when the stack runs from prebuilt registry images.
SYSTEM_UPDATER_COMPOSE_ENV_FILE=auto
SYSTEM_UPDATER_COMPOSE_FILES=docker-compose.prod.yml
SYSTEM_UPDATER_COMPOSE_PROJECT_NAME=core-panel
SYSTEM_UPDATER_COMPOSE_WORKDIR=/workspace
SYSTEM_UPDATER_FORCE_SELF_UPDATE_AVAILABLE=false
SYSTEM_UPDATER_RUNTIME_SERVICES=app,horizon,scheduler,nginx
SYSTEM_UPDATER_SELF_SERVICE=system-updater
SYSTEM_UPDATER_SELF_UPDATE_ENABLED=false
