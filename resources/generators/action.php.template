<?php

declare(strict_types=1);

namespace App\Domains\DummyDomain\Actions;

use App\Models\DummyModelClass;

final readonly class DummyActionClass
{
    /**
     * @param  array<string, mixed>  $attributes
     */
    public function execute(array $attributes): DummyModelClass
    {
        $DummyModelVariable = new DummyModelClass;
        $DummyModelVariable->fill($attributes);
        $DummyModelVariable->save();

        return $DummyModelVariable->refresh();
    }
}
